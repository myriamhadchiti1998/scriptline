   # Copy to backend/.env and fill in your key.
   ANTHROPIC_API_KEY=sk-ant-...

   # anthropic = real runs | mock = offline, deterministic (tests / UI only)
   LLM_PROVIDER=anthropic

   # Per-stage models and effort (low | medium | high | xhigh | max)
   MODEL_IDEATION=claude-sonnet-5-5
   MODEL_SCORING=claude-sonnet-5-5
   MODEL_SCRIPTING=claude-sonnet-5-5
   MODEL_REVIEW=claude-sonnet-5-5
   EFFORT_IDEATION=high
   EFFORT_SCORING=medium
   EFFORT_SCRIPTING=high
   EFFORT_REVIEW=high

   # Concepts per ideation run
   IDEA_BATCH_SIZE=12
   # Idea-memory similarity above which a new concept is dropped as a repeat
   DUPLICATE_THRESHOLD=0.62
   # Automatic rewrites after a failed review before a script is held
   MAX_REVISIONS=1
   # AI reviewer score (1-5) every checklist item needs
   REVIEW_PASS_SCORE=4
   # Parallel script jobs
   SCRIPT_WORKERS=2
   DEFAULT_CLIENT=sovereign_storefront
